generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  phone         String?        @unique
  passwordHash  String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  transactions  Transaction[]
  budgets       Budget[]
  subscriptions Subscription[]
  insights      Insight[]
}

model Transaction {
  id              String   @id @default(cuid())
  userId          String
  merchantName    String
  amount          Float
  type            TransactionType
  category        String
  paymentMode     String
  transactionDate DateTime
  source          String   @default("manual") // "sms" | "manual"
  referenceId     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionDate])
  @@index([category])
}

model Budget {
  id           String   @id @default(cuid())
  userId       String
  category     String
  monthlyLimit Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  merchantName    String
  amount          Float
  billingCycle    SubscriptionCycle
  nextBillingDate DateTime
  status          SubscriptionStatus @default(active)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Insight {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String
  type        InsightType
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TransactionType {
  debit
  credit
}

enum SubscriptionCycle {
  monthly
  yearly
  weekly
}

enum SubscriptionStatus {
  active
  paused
  cancelled
}

enum InsightType {
  spending_spike
  saving_opportunity
  category_alert
  subscription_reminder
  monthly_summary
}
